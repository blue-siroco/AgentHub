# Configuración del entorno local de Baziar (Docker Compose).
# Copia este fichero a `.env`. Todos los valores son de desarrollo y no sensibles:
# nunca reutilices estas credenciales fuera de tu máquina.

# --- General ---------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=info
COMPOSE_PROJECT_NAME=baziar
# Perfiles de Compose que arrancan: frontend (web), backend (api, worker y dependencias).
# Sin esta variable no arranca ningún servicio.
COMPOSE_PROFILES=frontend,backend

# --- Puertos publicados en el host (solo 127.0.0.1) ------------------------
WEB_HOST_PORT=3000
API_HOST_PORT=3001
POSTGRES_HOST_PORT=5432
LOCALSTACK_HOST_PORT=4566
MAILPIT_UI_HOST_PORT=8025

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=baziar
POSTGRES_PASSWORD=baziar
POSTGRES_DB=baziar

# --- Object storage (S3 emulado con LocalStack) ----------------------------
# Obligatorio: LocalStack no arranca sin token (https://app.localstack.cloud).
# Es un secreto personal: ponlo solo en `.env`, nunca en este fichero.
LOCALSTACK_AUTH_TOKEN=
# 1 conserva el contenido de S3 entre reinicios; requiere un plan de LocalStack que lo incluya.
LOCALSTACK_PERSISTENCE=0
# LocalStack acepta cualquier credencial; `test` es la convención de su documentación.
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_REGION=us-east-1
S3_BUCKET_PACKAGES=baziar-packages

# --- Correo de desarrollo (Mailpit) ----------------------------------------
MAIL_FROM=no-reply@baziar.local

# --- API -------------------------------------------------------------------
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000
# Login por email vía Mailpit. Prohibido con APP_ENV=production (lo impide la validación).
AUTH_DEV_EMAIL_LOGIN=true

# --- Worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2
